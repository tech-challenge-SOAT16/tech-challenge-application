        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_uptime_seconds, job)",
          "refId": "job"
        },
        "refresh": 2,
        "includeAll": false,
        "current": {
          "text": "techchallenge-api",
          "value": "techchallenge-api"
        }
      }
    ]
